{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["template_id", "version", "expected_revision", "idempotency_key"],
  "properties": {
    "template_id": {"type":"string","minLength":1,"maxLength":160},
    "version": {"type":"string","minLength":1,"maxLength":80},
    "expected_revision": {"type":"string","pattern":"^[0-9]+$"},
    "idempotency_key": {"type":"string","minLength":1,"maxLength":240}
  },
  "additionalProperties": false
}
