{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "database_url_secret", "auth_issuer", "auth_assertion_public_key", "render_callers", "admin_callers", "admin_actor_kinds", "fallback_locales"],
  "properties": {
    "schema": {"type":"string","minLength":1,"maxLength":63},
    "database_url_secret": {"type":"string","minLength":1,"maxLength":256},
    "auth_issuer": {"type":"string","minLength":1,"maxLength":256},
    "auth_assertion_public_key": {"type":"string","minLength":1,"maxLength":256},
    "render_callers": {"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "admin_callers": {"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "admin_actor_kinds": {"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["user","service_account"]}},
    "fallback_locales": {"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":32}}
  }
}
